target/

# Kernel fast-boot experiment artifacts. The images are GPL-2.0 and
# their source is not tracked, so they must never be committed.
kernel/linux-*.tar.xz*
kernel/vmlinuz-*
kernel/vmlinux-*
kernel/config-fastboot*
# The resolved config of the published guest kernel is tracked, because
# it is the one small file that says which options went into the image,
# and guest-kernel.yml diffs each build against it.
!kernel/config-fastboot-sandbox
kernel/SHA256SUMS*

# Agent and editor scratch state
/.claude/
/.codex/
CLAUDE.local.md
*.local.md
.DS_Store

# Run output from the lab scripts and the guest harnesses
*.log

# Operator-specific test configuration
/.env

# Site-specific patterns for tools/public-surface.sh
/.public-surface.local
