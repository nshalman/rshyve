# Tests that only one target compiles.
#
# Written by tools/check-test-parity.py, checked by the same script in
# CI. Every line is a test that runs on one platform and not the other,
# so every line is a deliberate decision that somebody has to make:
#
#   illumos-only  the CI suite never runs it. Only the build host can.
#   ci-only       the product platform never runs it.
#
# Add a line here when you mean it, and say why above it. If a test
# appears here that you did not intend to gate, fix the gate instead.
#
# Columns: side, package:kind:target, test name.

# These two open a real /dev/vmm and need the privilege to make a VM,
# so the whole file is `#![cfg(target_os = "illumos")]`. Only the build
# host runs them. See docs/testing.md.
illumos-only  vmm_core:test:autodestruct  armed_autodestruct_reclaims_the_instance_on_close
illumos-only  vmm_core:test:autodestruct  disarmed_autodestruct_keeps_the_instance

# DKIOCFLUSHWRITECACHE exists only on illumos. Linux never probes a
# device; it syncs every backing fd with fdatasync.
illumos-only  vmm_devices:lib:vmm_devices  blkdev::tests::a_char_device_that_fails_getwce_is_refused

# On illumos the peer credential carries a zone id that a plain unit
# test cannot set up, so these two run on the portable arms only. The
# illumos path is covered by the lab boot in docs/testing.md.
ci-only  vmm_core:lib:vmm_core  unixsock::peercred::tests::peer_credentials_match_current_process
ci-only  vmm_core:lib:vmm_core  unixsock::peercred::tests::the_default_policy_admits_this_process

# The refusal it tests is the path of a platform without privilege
# sets. illumos has them, so it never takes that path.
ci-only  vmm_machine:lib:vmm_machine  privilege::tests::a_platform_without_privilege_sets_refuses_to_lock
