# The guest kernel for a sandbox that runs untrusted code.
#
# .github/workflows/guest-kernel.yml builds it from these fragments, in
# this order:
#
#   container.config vsock.config smp.config rng.config virtiofs.config
#   sandbox.config
#
# Each fragment says why it is there. Two rules hold the list together.
# sandbox.config is LAST, because kconfig keeps the last assignment of an
# option and this is the only fragment that switches one off.
# hotplug.config stays OUT, because it sets CONFIG_SMP and CONFIG_NR_CPUS
# itself, so with smp.config the vCPU ceiling would follow fragment order.

# ── No vsock transport inside the guest ─────────────────────────
# VSOCKETS_LOOPBACK is "default y" under VSOCKETS
# (net/vmw_vsock/Kconfig:29-33), so olddefconfig turns it on as soon as
# vsock.config lands.
#
# Off, the guest has no local transport, so af_vsock.c:405-418 and
# :470-477 send every connect to the guest-to-host transport, which is
# virtio. A connect to CID 1, or to the guest's own CID, therefore leaves
# the guest, and the VMM answers RST because the destination is not the
# host CID (crates/vmm-virtio/src/vsock/mux.rs, on_guest_packet). A vsock
# port that the agent listens on is unreachable from inside the guest.
#
# Guest-to-host vsock stays open to every guest process. It is the
# control channel, and this option does not touch it.
#
# It guards the increment-2 transport only. The v1 agent listens on TCP
# 0.0.0.0:8299, which any guest process reaches through 127.0.0.1, so the
# v1 agent is a convenience and not a boundary.
# CONFIG_VSOCKETS_LOOPBACK is not set

# ── No unprivileged user namespaces ─────────────────────────────
# container.config:16 turns USER_NS on for a general container kernel.
# This kernel runs hostile code and builds no LSM, so `unshare -Ur` would
# give that code every capability in the new namespace, and with them the
# netfilter, nf_tables and overlayfs setup paths that this fragment list
# turns on. Those paths are the usual route to ring 0, where the code
# meets the VMM, which is the only boundary this design has.
#
# The cost is no rootless container inside the guest. The guest
# supervisor builds the payload container as real root and needs no uid
# mapping. Nothing in the 6.12.13 tree selects or depends on USER_NS, so
# this one line is the whole decision. Revisit it here.
# CONFIG_USER_NS is not set

# Residual exposure, recorded rather than fixed: no LSM is built, so
# in-guest access control is discretionary only, and a kernel bug that an
# ordinary syscall reaches still gives ring 0. Landlock would need a
# process that programs it. None does, and an unprivileged syscall that
# nothing uses is a cost.

# The brand splits bhyve-extra-opts on whitespace and the attr is capped near
# 256 bytes, so the launcher passes only a one-word cmdline. Everything else
# is built in. CMDLINE_OVERRIDE stays off so the launcher's sandbox_spec= word
# still reaches the guest.
#
# console=ttyS0 keeps panics visible; loglevel=0 keeps printk off the emulated
# UART, which costs about 200 ms of boot. tsc=reliable, no_timer_check and
# noapictimer skip the TSC and APIC timer calibration against the PIT, about
# 170 ms more. noapictimer drops the per-CPU timer for a broadcast one, so
# review it before multi-vCPU sandboxes become common.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyS0 quiet loglevel=0 tsc=reliable no_timer_check noapictimer"
# CONFIG_CMDLINE_OVERRIDE is not set

# A sandbox is a dev box. File watchers (bundlers, test runners, tsc -w,
# language servers, Claude Code) need inotify, or they poll or fail.
CONFIG_INOTIFY_USER=y

# THP "always" backs every large anonymous mapping with 2 MiB pages, which
# wastes memory in a guest this small. madvise leaves it to the programs
# that ask.
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# fq with BBR keeps large downloads fast across the NAT gateway. Both are
# small and built in.
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
# CONFIG_TCP_CONG_BIC is not set
# CONFIG_TCP_CONG_WESTWOOD is not set
# CONFIG_TCP_CONG_HTCP is not set

# The guest has no use for IPv6-in-IPv4 tunnels; sit0 is only clutter.
# CONFIG_IPV6_SIT is not set
